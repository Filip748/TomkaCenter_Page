---
/**
 * Przyklejony nagłówek z menu. Na telefonie menu rozwijane przyciskiem
 * (aria-expanded, Escape zamyka, focus wraca na przycisk).
 */
import Logo from './Logo.astro';
import { navItems } from '../lib/nav';
import { business } from '../lib/business';
---

<header
  class="sticky top-0 z-40 border-b border-sage-light/70 bg-cream/85 backdrop-blur-md supports-[not(backdrop-filter:blur(0))]:bg-cream"
>
  <div class="container-page flex h-16 items-center justify-between gap-4 sm:h-18">
    <a href="/" class="flex shrink-0 items-center" aria-label={`${business.name} – strona główna`}>
      <Logo class="h-10 w-auto sm:h-12" />
    </a>

    <nav aria-label="Główne menu" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-full px-3 py-2 text-[0.95rem] font-medium text-ink transition-colors hover:bg-mint hover:text-forest"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={`tel:${business.phone.e164}`} class="btn-primary hidden min-h-10 px-4 py-2 text-sm sm:inline-flex">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 5a2 2 0 0 1 2-2h2.3a1 1 0 0 1 1 .8l1 4a1 1 0 0 1-.5 1.1l-1.6.9a12 12 0 0 0 5 5l.9-1.6a1 1 0 0 1 1.1-.5l4 1a1 1 0 0 1 .8 1V19a2 2 0 0 1-2 2h-1C9.7 21 3 14.3 3 6V5Z"
          ></path></svg
        >
        {business.phone.display}
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex size-11 items-center justify-center rounded-full text-forest hover:bg-mint lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Otwórz menu</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2">
          <path class="icon-open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="icon-close hidden" stroke-linecap="round" d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Menu mobilne" class="hidden border-t border-sage-light bg-cream lg:hidden">
    <ul class="container-page flex flex-col py-3">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class="block rounded-xl px-3 py-3 text-lg font-medium text-ink hover:bg-mint">
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2 sm:hidden">
        <a href={`tel:${business.phone.e164}`} class="btn-primary w-full">Zadzwoń: {business.phone.display}</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.sr-only')!.textContent = open ? 'Zamknij menu' : 'Otwórz menu';
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
    menu.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  // Kliknięcie w link zamyka menu
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  // Escape zamyka menu i oddaje focus przyciskowi
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
