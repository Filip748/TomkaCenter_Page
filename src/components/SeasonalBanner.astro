---
/**
 * Sezonowy baner (np. choinki w grudniu). Treść z src/lib/seasons.ts.
 * Renderowany przy buildzie, w przeglądarce podmieniany, jeśli sezon się zmienił.
 */
import { seasonFor } from '../lib/seasons';

const season = seasonFor();
---

<!-- Sprite ikon sezonowych – <use> pozwala zmienić ikonę bez przeładowania -->
<svg aria-hidden="true" class="hidden">
  <symbol id="season-tree" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"
    ><path d="M12 2 6.5 9h3L5 15h4l-3.5 5h13L15 15h4l-4.5-6h3L12 2Z"></path><path d="M12 20v2"></path></symbol
  >
  <symbol id="season-sprout" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
    ><path d="M12 21v-9"></path><path d="M12 12c0-4-3-6-7-6 0 4 3 6 7 6Z"></path><path d="M12 10c0-3.5 2.5-6 7-6 0 4-3 6-7 6Z"
    ></path></symbol
  >
  <symbol id="season-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
    ><circle cx="12" cy="12" r="4"></circle><path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></symbol
  >
  <symbol id="season-leaf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
    ><path d="M5 19C5 10 10 5 20 4c-1 10-6 15-15 15Z"></path><path d="M5 19 13 11"></path></symbol
  >
  <symbol id="season-snow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
    ><path d="M12 2v20M3.3 7l17.4 10M3.3 17 20.7 7M9 4l3 2 3-2M9 20l3-2 3 2"></path></symbol
  >
</svg>

<a
  id="seasonal-banner"
  href={season.href}
  data-season={season.id}
  class="group inline-flex max-w-full items-center gap-3 rounded-full border border-blush bg-blush/60 py-1.5 pr-4 pl-1.5 text-sm text-forest shadow-soft transition hover:bg-blush"
>
  <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-white text-olive-700">
    <svg aria-hidden="true" class="size-5"><use href={`#season-${season.icon}`}></use></svg>
  </span>
  <span class="min-w-0">
    <strong data-title class="font-semibold">{season.title}</strong>
    <span data-text class="hidden sm:inline"> {season.text}</span>
  </span>
  <span aria-hidden="true" class="shrink-0 transition-transform group-hover:translate-x-0.5">→</span>
</a>

<script>
  import { seasonFor } from '../lib/seasons';

  const el = document.getElementById('seasonal-banner') as HTMLAnchorElement | null;
  const current = seasonFor();
  if (el && el.dataset.season !== current.id) {
    el.dataset.season = current.id;
    el.href = current.href;
    el.querySelector('[data-title]')!.textContent = current.title;
    el.querySelector('[data-text]')!.textContent = ` ${current.text}`;
    el.querySelector('use')?.setAttribute('href', `#season-${current.icon}`);
  }
</script>
