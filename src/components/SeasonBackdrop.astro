---
/**
 * Sezonowe tło sekcji „Poradnik”: cztery warstwy (zima, wiosna, lato, jesień)
 * z gradientem, pagórkiem u dołu i delikatnie kołyszącymi się dekoracjami.
 * Widoczna jest warstwa zgodna z atrybutem data-season rodzica (sekcji) –
 * zmiana miesiąca płynnie przenika między warstwami.
 * Dekoracje leżą głównie na marginesach, żeby nie przeszkadzać w czytaniu.
 */
import type { SeasonId } from '../data/calendar';

/** Dekoracja: pozycja w % sekcji, rozmiar w px, obrót, kolor, czas animacji. */
interface Deco {
  x: number;
  y: number;
  size: number;
  rot: number;
  color: string;
  dur: number;
  /** Tylko na szerszych ekranach (na telefonie wchodziłaby pod tekst). */
  wide?: boolean;
}

/* Wspólny „układ” pozycji – każda pora roku ma inne kształty i kolory. */
const layout: Array<Omit<Deco, 'color'>> = [
  { x: 86, y: 1.5, size: 72, rot: -10, dur: 7 },
  { x: 95, y: 8, size: 40, rot: 20, dur: 9 },
  { x: 72, y: 5, size: 44, rot: 35, dur: 8, wide: true },
  { x: 60, y: 1, size: 28, rot: 0, dur: 6.5, wide: true },
  { x: 1.5, y: 24, size: 56, rot: -25, dur: 10, wide: true },
  { x: 95.5, y: 30, size: 52, rot: 15, dur: 8.5 },
  { x: 0.5, y: 44, size: 36, rot: 40, dur: 7.5, wide: true },
  { x: 96, y: 52, size: 60, rot: -30, dur: 9.5, wide: true },
  { x: 2, y: 64, size: 46, rot: 25, dur: 8.8, wide: true },
  { x: 94, y: 74, size: 38, rot: 5, dur: 7.2, wide: true },
  { x: 2.5, y: 84, size: 64, rot: 10, dur: 8 },
  { x: 91, y: 90, size: 46, rot: -15, dur: 10 },
];

const palettes: Record<SeasonId, string[]> = {
  winter: ['#b9cfdc', '#ffffff', '#9fbccd', '#d6e4ec'],
  spring: ['#f2b8c6', '#f6d2dc', '#b9d9a3', '#f7c9a9'],
  summer: ['#f3cf6b', '#f6dd94', '#a9cf8a', '#f2b76b'],
  autumn: ['#e39a5c', '#d9784a', '#ebc26b', '#c9654f'],
};

const layers = (Object.keys(palettes) as SeasonId[]).map((season) => ({
  season,
  decos: layout.map((d, i) => ({ ...d, color: palettes[season][i % 4] })),
}));
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
  <!-- Kształty dekoracji (jeden symbol na porę roku) -->
  <svg class="hidden">
    <symbol id="deco-winter" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M12 2v20M3.3 7l17.4 10M3.3 17 20.7 7M9 3.5l3 2 3-2M9 20.5l3-2 3 2M3.5 10.5l2.5-1.2-.3-3M20.5 13.5 18 14.7l.3 3M3.5 13.5 6 14.7l-.3 3M20.5 10.5 18 9.3l.3-3"></path>
    </symbol>
    <symbol id="deco-spring" viewBox="0 0 24 24" fill="currentColor">
      <circle cx="12" cy="6.5" r="4"></circle><circle cx="17.2" cy="10.3" r="4"></circle><circle cx="15.2" cy="16.5" r="4"></circle><circle cx="8.8" cy="16.5" r="4"></circle><circle cx="6.8" cy="10.3" r="4"></circle><circle cx="12" cy="12" r="2.6" fill="#fff6d8"></circle>
    </symbol>
    <symbol id="deco-summer" viewBox="0 0 24 24" fill="currentColor">
      <circle cx="12" cy="12" r="5"></circle>
      <path d="M12 1.5 13 5h-2l1-3.5ZM12 22.5 11 19h2l-1 3.5ZM1.5 12 5 11v2l-3.5-1ZM22.5 12 19 13v-2l3.5 1ZM4.6 4.6l3.2 1.8-1.4 1.4-1.8-3.2ZM19.4 19.4l-3.2-1.8 1.4-1.4 1.8 3.2ZM19.4 4.6l-1.8 3.2-1.4-1.4 3.2-1.8ZM4.6 19.4l1.8-3.2 1.4 1.4-3.2 1.8Z"></path>
    </symbol>
    <symbol id="deco-autumn" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 15 6.5 16l1-2.5L3 10l2.5-.8L4.5 6l3.5 1L9 4.5l1.5 2L12 2.5l1.5 4 1.5-2L16 7l3.5-1-1 3.2L21 10l-4.5 3.5 1 2.5L12 15Z"></path>
      <path d="M12 21v-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </symbol>
  </svg>

  {
    layers.map(({ season, decos }) => (
      <div class="season-layer" data-layer={season}>
        {decos.map((d) => (
          <svg
            class:list={['deco', d.wide && 'hidden md:block']}
            style={`left:${d.x}%;top:${d.y}%;width:${d.size}px;height:${d.size}px;color:${d.color};--r:${d.rot}deg;--dur:${d.dur}s`}
          >
            <use href={`#deco-${season}`} />
          </svg>
        ))}
        <!-- Pagórek u dołu sekcji: śnieg / łąka / trawa / jesienne liście -->
        <svg class="hill" viewBox="0 0 1440 120" preserveAspectRatio="none">
          <path d="M0 80C240 30 480 20 720 50s480 60 720 10v60H0Z" />
        </svg>
      </div>
    ))
  }
</div>

<style>
  .season-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  /* Aktywna warstwa = pora roku ustawiona na sekcji (data-season) */
  :global([data-season='winter']) > div > [data-layer='winter'],
  :global([data-season='spring']) > div > [data-layer='spring'],
  :global([data-season='summer']) > div > [data-layer='summer'],
  :global([data-season='autumn']) > div > [data-layer='autumn'] {
    opacity: 1;
  }

  [data-layer='winter'] {
    background:
      radial-gradient(60rem 30rem at 85% -10%, #dfeaf1 0%, transparent 60%),
      linear-gradient(180deg, #eaf1f5 0%, #f3f6f6 55%, #faf7f0 100%);
  }
  [data-layer='spring'] {
    background:
      radial-gradient(50rem 26rem at 90% -5%, #fbe3ea 0%, transparent 60%),
      linear-gradient(180deg, #eef5e6 0%, #f5f7ee 55%, #faf7f0 100%);
  }
  [data-layer='summer'] {
    background:
      radial-gradient(46rem 26rem at 92% -8%, #fde8ad 0%, transparent 62%),
      linear-gradient(180deg, #fbf3dc 0%, #faf6e8 55%, #faf7f0 100%);
  }
  [data-layer='autumn'] {
    background:
      radial-gradient(50rem 26rem at 88% -8%, #f6d6bf 0%, transparent 60%),
      linear-gradient(180deg, #f8eadf 0%, #f9f1e8 55%, #faf7f0 100%);
  }

  .deco {
    position: absolute;
    opacity: 0.75;
    transform: rotate(var(--r));
    animation: sway var(--dur) ease-in-out infinite alternate;
    animation-play-state: paused;
  }
  /* Animujemy tylko widoczną warstwę */
  :global([data-season='winter']) > div > [data-layer='winter'] .deco,
  :global([data-season='spring']) > div > [data-layer='spring'] .deco,
  :global([data-season='summer']) > div > [data-layer='summer'] .deco,
  :global([data-season='autumn']) > div > [data-layer='autumn'] .deco {
    animation-play-state: running;
  }
  @keyframes sway {
    to {
      transform: translate(6px, 12px) rotate(calc(var(--r) + 14deg));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .deco {
      animation: none;
    }
  }

  .hill {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 7rem;
  }
  [data-layer='winter'] .hill { fill: #ffffff; opacity: 0.9; }
  [data-layer='spring'] .hill { fill: #d9ead0; opacity: 0.7; }
  [data-layer='summer'] .hill { fill: #cfe3b5; opacity: 0.7; }
  [data-layer='autumn'] .hill { fill: #efd2b4; opacity: 0.7; }
</style>
