---
/**
 * Hero: hasło, CTA („Zobacz ofertę”, „Zadzwoń”), sezonowy baner,
 * zdjęcie centrum z badge’em „Otwarte teraz”.
 */
import { Picture } from 'astro:assets';
import SeasonalBanner from '../SeasonalBanner.astro';
import OpenNow from '../OpenNow.astro';
import { business } from '../../lib/business';
import heroImg from '../../assets/images/gallery/555.jpg';

const years = new Date().getFullYear() - business.foundedYear;

const highlights = [
  { value: `${years}+ lat`, label: 'doświadczenia' },
  { value: 'Polskie', label: 'szkółki i producenci' },
  { value: 'Fachowe', label: 'doradztwo' },
];
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <!-- Dekoracyjne, rozmyte plamy koloru w tle -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-32 -left-24 size-[28rem] rounded-full bg-mint/60 blur-3xl"></div>
    <div class="absolute top-40 -right-32 size-[26rem] rounded-full bg-sage-light blur-3xl"></div>
  </div>

  <div class="container-page grid items-center gap-10 py-10 sm:py-16 lg:grid-cols-[1.05fr_1fr] lg:gap-14 lg:py-20">
    <div>
      <SeasonalBanner />

      <h1 id="hero-title" class="mt-6 text-4xl leading-[1.1] font-semibold sm:text-5xl lg:text-6xl">
        Wszystko dla Twojego ogrodu.
        <span class="block text-olive-700 italic">Zaufaj specjalistom!</span>
      </h1>

      <p class="mt-5 max-w-xl text-lg text-muted sm:text-xl">
        Rośliny ozdobne, drzewa i krzewy, choinki, ziemia, trawa i kora – w jednym miejscu w Sosnowcu. Od {
          business.foundedYear
        } roku doradzamy z pasją i w rodzinnej atmosferze.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#oferta" class="btn-primary">
          Zobacz ofertę
          <span aria-hidden="true">→</span>
        </a>
        <a href={`tel:${business.phone.e164}`} class="btn-secondary">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5a2 2 0 0 1 2-2h2.3a1 1 0 0 1 1 .8l1 4a1 1 0 0 1-.5 1.1l-1.6.9a12 12 0 0 0 5 5l.9-1.6a1 1 0 0 1 1.1-.5l4 1a1 1 0 0 1 .8 1V19a2 2 0 0 1-2 2h-1C9.7 21 3 14.3 3 6V5Z"
            ></path></svg
          >
          Zadzwoń: {business.phone.display}
        </a>
      </div>

      <dl class="mt-10 grid max-w-lg grid-cols-3 gap-4 border-t border-sage-light pt-6">
        {
          highlights.map((h) => (
            <div>
              <dt class="sr-only">{h.label}</dt>
              <dd class="font-display text-xl font-semibold text-forest sm:text-2xl">{h.value}</dd>
              <dd class="text-sm text-muted">{h.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="relative">
      <div class="overflow-hidden rounded-[2rem] shadow-lift ring-1 ring-sage-light">
        <Picture
          src={heroImg}
          formats={['avif', 'webp']}
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 560px, 100vw"
          alt="Zielony budynek TOMKA Centrum Ogrodnicze w Sosnowcu z kolorowymi rabatami i stołami pełnymi roślin"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full object-cover"
        />
      </div>
      <div class="absolute -bottom-5 left-4 sm:left-6">
        <OpenNow />
      </div>
      <div
        class="absolute -top-4 right-4 hidden rounded-2xl bg-white/95 px-4 py-3 text-sm shadow-soft sm:block"
        aria-hidden="true"
      >
        <span class="block font-display text-2xl font-semibold text-forest">od {business.foundedYear}</span>
        <span class="text-muted">rodzinna firma</span>
      </div>
    </div>
  </div>
</section>
