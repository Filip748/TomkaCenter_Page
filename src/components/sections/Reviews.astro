---
/**
 * Opinie klientów – bez cytatów (stara strona ich nie miała).
 * Zachęcamy do przeczytania/wystawienia opinii w Google i na Facebooku.
 * Linki: src/lib/business.ts (googleReviewsUrl, facebook).
 */
import { business } from '../../lib/business';
---

<section id="opinie" class="section pt-0" aria-labelledby="opinie-title">
  <div class="container-page">
    <div
      class="relative overflow-hidden rounded-[2rem] bg-mint/70 px-6 py-12 text-center ring-1 ring-sage/40 sm:px-12 sm:py-16"
      data-reveal
    >
      <!-- dekoracyjne listki -->
      <svg aria-hidden="true" viewBox="0 0 24 24" class="absolute -top-6 -left-6 size-40 rotate-12 text-sage/40" fill="currentColor"
        ><path d="M5 19C5 10 10 5 20 4c-1 10-6 15-15 15Z"></path></svg
      >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="absolute -right-8 -bottom-8 size-48 -rotate-45 text-sage/30" fill="currentColor"
        ><path d="M5 19C5 10 10 5 20 4c-1 10-6 15-15 15Z"></path></svg
      >

      <div class="relative mx-auto max-w-2xl">
        <span class="eyebrow bg-white">Opinie klientów</span>
        <h2 id="opinie-title" class="section-title">Co mówią o nas klienci?</h2>
        <p class="mt-4 text-lg text-muted">
          Przeczytaj opinie naszych klientów albo podziel się własną. Każda recenzja pomaga nam być jeszcze lepszymi
          i ułatwia innym znalezienie dobrego centrum ogrodniczego.
        </p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href={business.googleReviewsUrl} target="_blank" rel="noopener" class="btn-primary">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="currentColor"
              ><path d="m12 2 3 6.5 7 .8-5.2 4.8 1.4 6.9L12 17.5 5.8 21l1.4-6.9L2 9.3l7-.8L12 2Z"></path></svg
            >
            Opinie w Google<span class="sr-only"> (otwiera się w nowej karcie)</span>
          </a>
          <a href={`${business.facebook}/reviews`} target="_blank" rel="noopener" class="btn-secondary">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="currentColor"
              ><path
                d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8v3h2.6V21h2.9Z"
              ></path></svg
            >
            Oceń nas na Facebooku<span class="sr-only"> (otwiera się w nowej karcie)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
