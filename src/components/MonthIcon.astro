---
/**
 * Ikony miesięcy w kalendarzu prac (liniowe SVG 24×24, kolor = currentColor).
 * Klucze: MonthIconId w src/data/calendar.ts.
 */
import type { MonthIconId } from '../data/calendar';

interface Props {
  name: MonthIconId;
  class?: string;
}
const { name, class: className } = Astro.props;

/** Każda ikona to zestaw kształtów SVG (rysowane obrysem). */
const icons: Record<MonthIconId, string> = {
  // Styczeń – bałwan
  snowman:
    '<circle cx="12" cy="7" r="3.5"/><circle cx="12" cy="16" r="5"/><path d="M12 7.5h2.5"/><path d="M7 14 3.5 11.5M17 14l3.5-2.5"/><path d="M8.5 3.5h7"/>',
  // Luty – nożyce do cięcia drzew
  shears:
    '<circle cx="6.5" cy="18" r="3"/><circle cx="17.5" cy="18" r="3"/><path d="M8.5 15.8 17 3.5M15.5 15.8 7 3.5"/>',
  // Marzec – kiełek
  sprout: '<path d="M12 21v-9"/><path d="M12 12c0-4-3-6-7-6 0 4 3 6 7 6Z"/><path d="M12 10c0-3.5 2.5-6 7-6 0 4-3 6-7 6Z"/><path d="M7 21h10"/>',
  // Kwiecień – tulipan
  tulip:
    '<path d="M7 4l2.5 2.5L12 3l2.5 3.5L17 4v5a5 5 0 0 1-10 0V4Z"/><path d="M12 14v7"/><path d="M12 19c-2.5 0-4.5-1.5-5-4 2.5 0 4.5 1.5 5 4Z"/>',
  // Maj – kwiat
  blossom:
    '<circle cx="12" cy="6.8" r="3"/><circle cx="16.9" cy="10.4" r="3"/><circle cx="15" cy="16.2" r="3"/><circle cx="9" cy="16.2" r="3"/><circle cx="7.1" cy="10.4" r="3"/><circle cx="12" cy="12" r="1.6"/>',
  // Czerwiec – truskawka
  strawberry:
    '<path d="M12 8c4.5 0 7 2 7 5 0 4-4 8-7 8s-7-4-7-8c0-3 2.5-5 7-5Z"/><path d="M12 8 9 4.5M12 8l3-3.5M12 8V3.5"/><path d="M9.5 12.5h.01M14.5 12.5h.01M12 15.5h.01M9.5 17.5h.01M14.5 17.5h.01"/>',
  // Lipiec – słońce
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/>',
  // Sierpień – konewka
  'watering-can':
    '<path d="M5 9h10v9a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V9Z"/><path d="M15 12l5-5"/><path d="M19 5.5l2.5 2.5"/><path d="M5 11.5C3 11.5 2.5 9.5 3.5 8"/><path d="M8 9V6.5a2 2 0 0 1 4 0V9"/>',
  // Wrzesień – jabłko
  apple:
    '<path d="M12 7.5c-1.5-1-5.5-1.5-7 2s.5 9.5 3.5 10.5c1.4.5 2.4-.3 3.5-.3s2.1.8 3.5.3c3-1 5-7 3.5-10.5s-5.5-3-7-2Z"/><path d="M12 7.5c0-2 .5-3.5 2-4.5"/><path d="M12.5 5c1.5-1.5 3.5-1.5 4.5-1-.5 1.5-2.5 2.5-4.5 1Z"/>',
  // Październik – liść klonu
  leaf: '<path d="M12 21v-6"/><path d="M12 15 6.5 16l1-2.5L3 10l2.5-.8L4.5 6l3.5 1L9 4.5l1.5 2L12 2.5l1.5 4 1.5-2L16 7l3.5-1-1 3.2L21 10l-4.5 3.5 1 2.5L12 15Z"/>',
  // Listopad – grabie
  rake: '<path d="M12 2.5V14"/><path d="M5 14h14"/><path d="M6 14v6M9 14v6M12 14v6M15 14v6M18 14v6"/>',
  // Grudzień – choinka
  tree: '<path d="M12 2.5 6.5 9.5h3L5 15.5h4l-3.5 4.5h13L15 15.5h4l-4.5-6h3L12 2.5Z"/><path d="M12 20v2"/>',
};
---

<svg
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  set:html={icons[name]}
/>
