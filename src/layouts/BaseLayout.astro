---
/**
 * Główny layout: <head> z SEO (meta, Open Graph, JSON-LD), nagłówek, stopka.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../lib/business';
import { localBusinessJsonLd } from '../lib/schema';
// Preload fontu nagłówków (zestaw łaciński) – szybszy render hasła w Hero.
// Vite nadaje im ten sam hash co w CSS, więc przeglądarka nie pobiera ich dwa razy.
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Ścieżka obrazka OG względem /public. */
  ogImage?: string;
  /** Dodaje JSON-LD LocalBusiness (tylko strona główna). */
  withBusinessSchema?: boolean;
  noindex?: boolean;
}

const {
  title = `${business.name} – Sosnowiec | Rośliny, drzewa, choinki, ziemia, kora`,
  description = business.description,
  ogImage = '/og-image.jpg',
  withBusinessSchema = false,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.href ?? 'https://www.tomka.pl/';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;
const jsonLd = withBusinessSchema ? localBusinessJsonLd(siteUrl, ogImageUrl) : null;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#2f4a34" />

    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Lokalne SEO -->
    <meta name="geo.region" content="PL-SL" />
    <meta name="geo.placename" content={business.address.city} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Klasa .js włącza animacje scrolla tylko gdy działa JavaScript -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#tresc"
      class="sr-only z-50 rounded-full bg-forest px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Przejdź do treści
    </a>
    <Header />
    <main id="tresc" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
