---
/** Strona błędu 404 (Vercel i Netlify serwują ją automatycznie). */
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../lib/business';
---

<BaseLayout title={`Nie znaleziono strony – ${business.name}`} noindex>
  <section class="section">
    <div class="container-page max-w-xl text-center">
      <p class="font-display text-8xl font-semibold text-sage">404</p>
      <h1 class="mt-4 text-3xl font-semibold">Ups, ta ścieżka zarosła</h1>
      <p class="mt-4 text-lg text-muted">
        Nie znaleźliśmy strony, której szukasz. Może została przeniesiona albo adres zawiera literówkę.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Strona główna</a>
        <a href="/#kontakt" class="btn-secondary">Kontakt</a>
      </div>
    </div>
  </section>
</BaseLayout>
